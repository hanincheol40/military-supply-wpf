<!-- WPF 애플리케이션 전체에서 공유하는 디자인 리소스 모음 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- Paperlogy 글꼴 리소스: Regular(4), Medium(5), SemiBold(6), Bold(7) -->
	<FontFamily x:Key="PaperlogyRegular">/MilitarySupply;component/Assets/Fonts/#Paperlogy 4</FontFamily>
	<FontFamily x:Key="PaperlogyMedium">/MilitarySupply;component/Assets/Fonts/#Paperlogy 5</FontFamily>
	<FontFamily x:Key="PaperlogySemiBold">/MilitarySupply;component/Assets/Fonts/#Paperlogy 6</FontFamily>
	<FontFamily x:Key="PaperlogyBold">/MilitarySupply;component/Assets/Fonts/#Paperlogy 7</FontFamily>
	<!-- 기본 색상값: 흰색, 본문 텍스트, 선택 영역 -->
	<Color x:Key="WhiteColor">#FFFFFF</Color>
	<Color x:Key="TextColor">#1E2124</Color>
	<Color x:Key="SelectionColor">#ECF2FE</Color>
	<!-- 공통 배경·텍스트·테두리 및 상호작용 상태 색상 -->
	<SolidColorBrush x:Key="Surface" Color="{StaticResource WhiteColor}"/>
	<SolidColorBrush x:Key="Canvas" Color="#F4F5F6"/>
	<SolidColorBrush x:Key="SubtleSurface" Color="#F4F5F6"/>
	<SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
	<SolidColorBrush x:Key="Muted" Color="#464C53"/>
	<SolidColorBrush x:Key="Line" Color="#CDD1D5"/>
	<SolidColorBrush x:Key="ControlLine" Color="#58616A"/>
	<SolidColorBrush x:Key="Hover" Color="#D8E5FD"/>
	<SolidColorBrush x:Key="Pressed" Color="#B1CEFB"/>
	<SolidColorBrush x:Key="Accent" Color="#256EF4"/>
	<SolidColorBrush x:Key="AccentHover" Color="#0B50D0"/>
	<SolidColorBrush x:Key="AccentPressed" Color="#083891"/>
	<SolidColorBrush x:Key="AccentSubtle" Color="{StaticResource SelectionColor}"/>
	<SolidColorBrush x:Key="AccentText" Color="#0B50D0"/>
	<SolidColorBrush x:Key="Focus" Color="#256EF4"/>
	<!-- 상태별 의미 색상: 정상, 주의, 위험 -->
	<SolidColorBrush x:Key="Success" Color="#1A662B"/>
	<SolidColorBrush x:Key="SuccessSurface" Color="#EAF6EC"/>
	<SolidColorBrush x:Key="Warning" Color="#7A4D00"/>
	<SolidColorBrush x:Key="WarningSurface" Color="#FFF3DB"/>
	<SolidColorBrush x:Key="Danger" Color="#B02A12"/>
	<!-- 장비 미리보기 및 드래그 앤 드롭 영역 전용 색상 -->
	<SolidColorBrush x:Key="PreviewSurface" Color="#242424"/>
	<SolidColorBrush x:Key="PreviewLine" Color="#404040"/>
	<SolidColorBrush x:Key="PreviewShadow" Color="#171717"/>
	<SolidColorBrush x:Key="PreviewZone" Color="#14000000"/>
	<SolidColorBrush x:Key="PreviewZoneLine" Color="#86919D"/>
	<SolidColorBrush x:Key="PreviewDrop" Color="#66366A99"/>
	<SolidColorBrush x:Key="PreviewDropLine" Color="#99CFFF"/>
	<SolidColorBrush x:Key="PreviewText" Color="#FFFFFF"/>
	<!-- 공통 모서리 반경: 입력 컨트롤과 패널 -->
	<CornerRadius x:Key="ControlRadius">6</CornerRadius>
	<CornerRadius x:Key="PanelRadius">8</CornerRadius>
	<!-- 상태 배지 및 비활성 컨트롤에 사용하는 배경·텍스트 색상 -->
	<SolidColorBrush x:Key="DangerSurface" Color="#FDEDE9"/>
	<SolidColorBrush x:Key="DisabledSurface" Color="#CDD1D5"/>
	<SolidColorBrush x:Key="DisabledText" Color="#464C53"/>
	<!-- 키보드 포커스 시 컨트롤 바깥에 강조 테두리 표시 -->
	<Style x:Key="KeyboardFocusVisual" TargetType="Control">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Border Margin="-3" BorderBrush="{StaticResource Focus}" BorderThickness="2" CornerRadius="{StaticResource ControlRadius}" IsHitTestVisible="False"/>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!-- 기본 탭 항목·사용자 정의 화면의 글자색과 글꼴 -->
	<Style TargetType="TabItem">
		<Setter Property="Foreground" Value="{StaticResource Text}"/>
		<Setter Property="FontFamily" Value="{StaticResource PaperlogyRegular}"/>
	</Style>
	<Style TargetType="UserControl">
		<Setter Property="Foreground" Value="{StaticResource Text}"/>
	</Style>
	<!-- 보급 업무 흐름: 단계 상자, 설명 텍스트, 번호, 연결 화살표 -->
	<Style x:Key="FlowStep" TargetType="Border">
		<Setter Property="Background" Value="{StaticResource SubtleSurface}"/>
		<Setter Property="BorderBrush" Value="{StaticResource Line}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
		<Setter Property="Padding" Value="10,10"/>
	</Style>
	<Style x:Key="FlowLabel" TargetType="TextBlock">
		<Setter Property="FontFamily" Value="{StaticResource PaperlogySemiBold}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="Foreground" Value="{StaticResource Text}"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
	<Style x:Key="FlowNumber" TargetType="TextBlock">
		<Setter Property="FontFamily" Value="{StaticResource PaperlogyMedium}"/>
		<Setter Property="FontWeight" Value="Medium"/>
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="Foreground" Value="{StaticResource AccentText}"/>
		<Setter Property="Margin" Value="0,0,10,0"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
	<Style x:Key="FlowArrow" TargetType="Path">
		<Setter Property="Data" Value="M 0,6 L 16,6 M 10,0 L 16,6 L 10,12"/>
		<Setter Property="Stroke" Value="{StaticResource Muted}"/>
		<Setter Property="StrokeThickness" Value="2"/>
		<Setter Property="StrokeStartLineCap" Value="Round"/>
		<Setter Property="StrokeEndLineCap" Value="Round"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
	<SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource WhiteColor}"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource TextColor}"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource WhiteColor}"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource TextColor}"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource SelectionColor}"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource TextColor}"/>
	<!-- 기본 텍스트: 세로 중앙 정렬 및 굵기별 Paperlogy 글꼴 -->
	<Style TargetType="TextBlock">
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Style.Triggers>
			<Trigger Property="FontWeight" Value="Medium">
				<Setter Property="FontFamily" Value="{StaticResource PaperlogyMedium}"/>
			</Trigger>
			<Trigger Property="FontWeight" Value="SemiBold">
				<Setter Property="FontFamily" Value="{StaticResource PaperlogySemiBold}"/>
			</Trigger>
			<Trigger Property="FontWeight" Value="Bold">
				<Setter Property="FontFamily" Value="{StaticResource PaperlogyBold}"/>
			</Trigger>
		</Style.Triggers>
	</Style>
	<!-- 보조 설명 및 섹션 제목 텍스트 스타일 -->
	<Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
		<Setter Property="Foreground" Value="{StaticResource Muted}"/>
		<Setter Property="FontSize" Value="13"/>
	</Style>
	<Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
		<Setter Property="FontSize" Value="18"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Margin" Value="0,0,0,16"/>
	</Style>
	<!-- 공통 패널: 배경, 테두리, 모서리 반경, 내부 여백 -->
	<Style x:Key="Panel" TargetType="Border">
		<Setter Property="Background" Value="{StaticResource Surface}"/>
		<Setter Property="BorderBrush" Value="{StaticResource Line}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="{StaticResource PanelRadius}"/>
		<Setter Property="Padding" Value="20"/>
	</Style>
	<!-- 기본 버튼: 외형 템플릿, 마우스 반응, 비활성 상태, 포커스 표시 -->
	<Style TargetType="Button">
		<Setter Property="Background" Value="{StaticResource AccentSubtle}"/>
		<Setter Property="Foreground" Value="{StaticResource AccentText}"/>
		<Setter Property="BorderBrush" Value="{StaticResource AccentText}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Padding" Value="14,6"/>
		<Setter Property="MinHeight" Value="40"/>
		<Setter Property="FontWeight" Value="Medium"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlRadius}" Padding="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="Chrome" Property="Background" Value="{StaticResource DisabledSurface}"/>
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DisabledSurface}"/>
							<Setter TargetName="Chrome" Property="TextElement.Foreground" Value="{StaticResource DisabledText}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="{StaticResource Hover}"/>
			</Trigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter Property="Background" Value="{StaticResource Pressed}"/>
			</Trigger>
		</Style.Triggers>
	</Style>
	<!-- 주요 작업 버튼: 기본 버튼 스타일을 상속하고 강조색 적용 -->
	<Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
		<Setter Property="Background" Value="{StaticResource Accent}"/>
		<Setter Property="Foreground" Value="{StaticResource Surface}"/>
		<Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="{StaticResource AccentHover}"/>
				<Setter Property="BorderBrush" Value="{StaticResource AccentHover}"/>
			</Trigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter Property="Background" Value="{StaticResource AccentPressed}"/>
				<Setter Property="BorderBrush" Value="{StaticResource AccentPressed}"/>
			</Trigger>
		</Style.Triggers>
	</Style>
	<!-- 텍스트 입력창: 색상·크기·입력 영역·포커스·비활성 상태 -->
	<Style TargetType="TextBox">
		<Setter Property="Background" Value="{StaticResource Surface}"/>
		<Setter Property="Foreground" Value="{StaticResource Text}"/>
		<Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
		<Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
		<Setter Property="BorderBrush" Value="{StaticResource ControlLine}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Padding" Value="10,6"/>
		<Setter Property="Margin" Value="0,6,0,14"/>
		<Setter Property="MinHeight" Value="40"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="TextBox">
					<Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlRadius}" Padding="{TemplateBinding Padding}">
						<ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsKeyboardFocusWithin" Value="True">
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Focus}"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="Chrome" Property="Background" Value="{StaticResource DisabledSurface}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!-- 드롭다운 선택창: 토글 버튼, 선택 항목, 팝업 목록 -->
	<Style TargetType="ComboBox">
		<Setter Property="MinHeight" Value="40"/>
		<Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
		<Setter Property="Background" Value="{StaticResource Surface}"/>
		<Setter Property="Foreground" Value="{StaticResource Text}"/>
		<Setter Property="BorderBrush" Value="{StaticResource ControlLine}"/>
		<Setter Property="Padding" Value="8"/>
		<Setter Property="Margin" Value="0,5,0,14"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ComboBox">
					<Grid>
						<ToggleButton x:Name="Toggle" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False">
							<ToggleButton.Template>
								<ControlTemplate TargetType="ToggleButton">
									<Border Background="{StaticResource Surface}" BorderBrush="{StaticResource ControlLine}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="8,6">
										<TextBlock Text="⌄" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/>
									</Border>
								</ControlTemplate>
							</ToggleButton.Template>
						</ToggleButton>
						<ContentPresenter Content="{Binding SelectedItem.Display, RelativeSource={RelativeSource TemplatedParent}}" Margin="10,6,30,6" VerticalAlignment="Center" IsHitTestVisible="False"/>
						<Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
							<Border Background="{StaticResource Surface}" BorderBrush="{StaticResource ControlLine}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260">
								<ScrollViewer>
									<ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
								</ScrollViewer>
							</Border>
						</Popup>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!-- 드롭다운 목록 항목: 여백·글자색·굵기별 글꼴 -->
	<Style TargetType="ComboBoxItem">
		<Setter Property="Padding" Value="10,8"/>
		<Setter Property="Foreground" Value="{StaticResource Text}"/>
		<Style.Triggers>
			<Trigger Property="FontWeight" Value="Medium">
				<Setter Property="FontFamily" Value="{StaticResource PaperlogyMedium}"/>
			</Trigger>
			<Trigger Property="FontWeight" Value="SemiBold">
				<Setter Property="FontFamily" Value="{StaticResource PaperlogySemiBold}"/>
			</Trigger>
			<Trigger Property="FontWeight" Value="Bold">
				<Setter Property="FontFamily" Value="{StaticResource PaperlogyBold}"/>
			</Trigger>
		</Style.Triggers>
	</Style>
	<!-- 체크박스: 글자색·바깥 여백·키보드 포커스 -->
	<Style TargetType="CheckBox">
		<Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
		<Setter Property="Foreground" Value="{StaticResource Text}"/>
		<Setter Property="Margin" Value="0,4,0,16"/>
	</Style>
	<!-- 데이터 표: 읽기 전용, 단일 행 선택, 크기·배경·격자선 -->
	<Style TargetType="DataGrid">
		<Setter Property="AutoGenerateColumns" Value="False"/>
		<Setter Property="IsReadOnly" Value="True"/>
		<Setter Property="CanUserAddRows" Value="False"/>
		<Setter Property="CanUserDeleteRows" Value="False"/>
		<Setter Property="SelectionMode" Value="Single"/>
		<Setter Property="SelectionUnit" Value="FullRow"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{StaticResource Text}"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="RowBackground" Value="{StaticResource Surface}"/>
		<Setter Property="AlternatingRowBackground" Value="{StaticResource Surface}"/>
		<Setter Property="GridLinesVisibility" Value="Horizontal"/>
		<Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}"/>
		<Setter Property="HeadersVisibility" Value="Column"/>
		<Setter Property="RowHeight" Value="40"/>
		<Setter Property="ColumnHeaderHeight" Value="40"/>
		<Setter Property="MinHeight" Value="120"/>
	</Style>
	<!-- 데이터 표 열 머리글: 글꼴·배경·테두리·여백 -->
	<Style TargetType="DataGridColumnHeader">
		<Setter Property="FontFamily" Value="{StaticResource PaperlogySemiBold}"/>
		<Setter Property="Background" Value="{StaticResource SubtleSurface}"/>
		<Setter Property="Foreground" Value="{StaticResource Text}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="BorderBrush" Value="{StaticResource Line}"/>
		<Setter Property="Padding" Value="10,8"/>
		<Setter Property="BorderThickness" Value="0,1,0,1"/>
	</Style>
	<!-- 데이터 표 셀: 내부 여백·표시 템플릿·선택 강조 -->
	<Style TargetType="DataGridCell">
		<Setter Property="Padding" Value="10,0"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="DataGridCell">
					<Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
						<ContentPresenter VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger Property="IsSelected" Value="True">
				<Setter Property="Background" Value="{StaticResource AccentSubtle}"/>
				<Setter Property="Foreground" Value="{StaticResource Text}"/>
			</Trigger>
		</Style.Triggers>
	</Style>
	<!-- 데이터 표 행: 테두리 제거와 마우스 오버 배경 -->
	<Style TargetType="DataGridRow">
		<Setter Property="BorderThickness" Value="0"/>
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="{StaticResource SubtleSurface}"/>
			</Trigger>
		</Style.Triggers>
	</Style>
	<!-- 상태 텍스트: 기본 정상색 및 부족·승인 대기·반납 완료 색상 -->
	<Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
		<Setter Property="Foreground" Value="{StaticResource Success}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Style.Triggers>
			<DataTrigger Binding="{Binding Status}" Value="부족">
				<Setter Property="Foreground" Value="{StaticResource Danger}"/>
			</DataTrigger>
			<DataTrigger Binding="{Binding Status}" Value="승인 대기">
				<Setter Property="Foreground" Value="{StaticResource Warning}"/>
			</DataTrigger>
			<DataTrigger Binding="{Binding Status}" Value="반납 완료">
				<Setter Property="Foreground" Value="{StaticResource Muted}"/>
			</DataTrigger>
		</Style.Triggers>
	</Style>
	<!-- 상태 셀 배지: 상태 문자열을 표시하고 상태에 따라 배경색 변경 -->
	<DataTemplate x:Key="StatusCell">
		<Border x:Name="Badge" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="4" Background="{StaticResource SuccessSurface}" Padding="6,3">
			<TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" FontSize="12"/>
		</Border>
		<DataTemplate.Triggers>
			<DataTrigger Binding="{Binding Status}" Value="부족">
				<Setter TargetName="Badge" Property="Background" Value="{StaticResource DangerSurface}"/>
			</DataTrigger>
			<DataTrigger Binding="{Binding Status}" Value="승인 대기">
				<Setter TargetName="Badge" Property="Background" Value="{StaticResource WarningSurface}"/>
			</DataTrigger>
			<DataTrigger Binding="{Binding Status}" Value="반납 완료">
				<Setter TargetName="Badge" Property="Background" Value="{StaticResource SubtleSurface}"/>
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>
</ResourceDictionary>
