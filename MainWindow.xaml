<Window x:Class="MilitarySupply.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MilitarySupply.Views"
        Title="군수품 보급 · 개인장비 관리 시스템"
        Width="1080" Height="760"
        MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Canvas}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource PaperlogyRegular}"
        FontSize="15">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ===== 상단 헤더 ===== -->
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                Background="{StaticResource Surface}" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{StaticResource Accent}" Margin="0,0,12,0"/>
                    <TextBlock Text="군수품 보급 · 개인장비 관리 시스템" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Today}" Foreground="{StaticResource Muted}"/>
            </Grid>
        </Border>

        <!-- ===== 본문 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측 내비게이션 -->
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,1,0" Padding="10,12,10,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="{StaticResource Line}" Margin="4,15"/>
                        <TextBlock Text="로컬 데이터 저장소" FontSize="12"
                                   Foreground="{StaticResource Text}" Margin="9,0,0,7"/>
                        <TextBlock Text="JSON 자동 저장 · XLSX 연동" FontSize="10"
                                   Foreground="{StaticResource Muted}" Margin="9,0,0,0"/>
                        <TextBlock Text="PILOT / 가상 데모 포함" FontSize="10"
                                   Foreground="{StaticResource Muted}" Margin="9,8,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <ListBox ItemsSource="{Binding Menu}"
                                 SelectedIndex="{Binding PageIndex}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="Margin" Value="0,0,0,4"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="NavBd" Background="Transparent"
                                                        CornerRadius="{StaticResource ControlRadius}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <Grid>
                                                        <Border x:Name="SelectionMarker" Width="3"
                                                                HorizontalAlignment="Left"
                                                                Background="{StaticResource Accent}"
                                                                CornerRadius="2" Margin="-8,3,0,3"
                                                                Visibility="Collapsed"/>
                                                        <ContentPresenter/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="NavBd" Property="Background" Value="{StaticResource AccentSubtle}"/>
                                                        <Setter TargetName="SelectionMarker" Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                            <Condition Property="IsSelected" Value="False"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="NavBd" Property="Background" Value="{StaticResource Hover}"/>
                                                    </MultiTrigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="NavBd" Property="BorderBrush" Value="{StaticResource Focus}"/>
                                                        <Setter TargetName="NavBd" Property="BorderThickness" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="19" Width="30"/>
                                        <TextBlock Text="{Binding Title}" FontWeight="Medium"
                                                   FontSize="15" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 우측 콘텐츠 -->
            <Grid Grid.Column="1" Margin="24,18,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 페이지 제목 + 상단 버튼 -->
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding PageTitle}" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="{Binding PageSubtitle}" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="↙  XLSX 가져오기" Command="{Binding ImportCommand}" Margin="0,0,8,0"/>
                        <Button Content="↗  XLSX 내보내기" Command="{Binding ExportCommand}" Margin="0,0,8,0"/>
                        <Button Content="저장" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Grid>

                <TabControl Grid.Row="1" SelectedIndex="{Binding PageIndex}"
                            Background="Transparent" Foreground="{StaticResource Text}"
                            BorderThickness="0">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </ControlTemplate>
                    </TabControl.Template>

                    <!-- ===== 대시보드 ===== -->
                    <TabItem Header="대시보드">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- 업무 흐름 -->
                                <Border Style="{StaticResource Panel}" Padding="16"
                                        Background="{StaticResource AccentSubtle}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <TextBlock Text="보급 업무 흐름" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Text}"/>
                                            <TextBlock Text="등록부터 이력 저장까지" FontSize="11"
                                                       Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>

                                            <Border Style="{StaticResource FlowStep}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="01" Style="{StaticResource FlowNumber}"/>
                                                    <TextBlock Text="재고 등록" Style="{StaticResource FlowLabel}"/>
                                                </StackPanel>
                                            </Border>
                                            <Path Grid.Column="1" Style="{StaticResource FlowArrow}"/>

                                            <Border Grid.Column="2" Style="{StaticResource FlowStep}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="02" Style="{StaticResource FlowNumber}"/>
                                                    <TextBlock Text="병사 선택" Style="{StaticResource FlowLabel}"/>
                                                </StackPanel>
                                            </Border>
                                            <Path Grid.Column="3" Style="{StaticResource FlowArrow}"/>

                                            <Border Grid.Column="4" Style="{StaticResource FlowStep}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="03" Style="{StaticResource FlowNumber}"/>
                                                    <TextBlock Text="장비 지급" Style="{StaticResource FlowLabel}"/>
                                                </StackPanel>
                                            </Border>
                                            <Path Grid.Column="5" Style="{StaticResource FlowArrow}"/>

                                            <Border Grid.Column="6" Style="{StaticResource FlowStep}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="04" Style="{StaticResource FlowNumber}"/>
                                                    <TextBlock Text="보급 처리" Style="{StaticResource FlowLabel}"/>
                                                </StackPanel>
                                            </Border>
                                            <Path Grid.Column="7" Style="{StaticResource FlowArrow}"/>

                                            <Border Grid.Column="8" Style="{StaticResource FlowStep}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="05" Style="{StaticResource FlowNumber}"/>
                                                    <TextBlock Text="이력 저장" Style="{StaticResource FlowLabel}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 지표 카드 -->
                                <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,0,-12,20">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Panel}" Margin="0,0,12,0" Padding="18">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="22" Foreground="{Binding Color}" Margin="0,0,12,0"/>
                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource Muted}"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Value}" FontSize="32" FontWeight="Bold"
                                                               Foreground="{Binding Color}" Margin="0,14,0,6"/>
                                                    <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{StaticResource Muted}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 장비 지급 현황 -->
                                    <Border Style="{StaticResource Panel}" Margin="0,0,16,0">
                                        <StackPanel>
                                            <TextBlock Text="장비 지급 현황" Style="{StaticResource SectionTitle}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="216"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Viewbox Width="200" Height="200">
                                                    <Grid Width="200" Height="200">
                                                        <Ellipse Stroke="{StaticResource Line}" StrokeThickness="23" Margin="17"/>
                                                        <Path Data="{Binding DonutPath}" Stroke="{StaticResource Accent}"
                                                              StrokeThickness="23"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding RateText}" FontSize="36" FontWeight="Bold"
                                                                       HorizontalAlignment="Center"/>
                                                            <TextBlock Text="필수장비 지급률" Foreground="{StaticResource Muted}"
                                                                       FontSize="11" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Viewbox>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <TextBlock Text="●  지급 완료" Foreground="{StaticResource Success}"/>
                                                    <TextBlock Text="{Binding CompleteCount, StringFormat={}{0}명}"
                                                               FontSize="24" FontWeight="Bold" Margin="16,4,0,20"/>
                                                    <TextBlock Text="●  미완료" Foreground="{StaticResource Muted}"/>
                                                    <TextBlock Text="{Binding IncompleteCount, StringFormat={}{0}명}"
                                                               FontSize="24" FontWeight="Bold" Margin="16,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="필수로 지정된 모든 장비를 보유한 병사 기준"
                                                       Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 재고 부족 알림 -->
                                    <Border Grid.Column="1" Style="{StaticResource Panel}">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="재고 부족 알림" Style="{StaticResource SectionTitle}"/>
                                                <TextBlock Text="최소재고 미만" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource Warning}" FontSize="11" Margin="0,0,0,16"/>
                                            </DockPanel>
                                            <DataGrid ItemsSource="{Binding LowItems}" Height="245">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="품목명" Binding="{Binding Name}" Width="*"/>
                                                    <DataGridTextColumn Header="가용" Binding="{Binding Quantity}" Width="70"/>
                                                    <DataGridTextColumn Header="기준" Binding="{Binding Minimum}" Width="70"/>
                                                    <DataGridTemplateColumn Header="상태" CellTemplate="{StaticResource StatusCell}" Width="70"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 최근 보급 요청 -->
                                <Border Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <TextBlock Text="최근 보급 요청" Style="{StaticResource SectionTitle}"/>
                                        <DataGrid ItemsSource="{Binding RecentRequests}" Height="170">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="요청일" Binding="{Binding Date, StringFormat=MM-dd}" Width="90"/>
                                                <DataGridTextColumn Header="품목" Binding="{Binding Item}" Width="140"/>
                                                <DataGridTextColumn Header="수량" Binding="{Binding Quantity}" Width="70"/>
                                                <DataGridTextColumn Header="요청 사유" Binding="{Binding Reason}" Width="*"/>
                                                <DataGridTemplateColumn Header="처리 상태" CellTemplate="{StaticResource StatusCell}" Width="100"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== 병사 관리 ===== -->
                    <TabItem Header="병사 관리">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Panel}" Margin="0,0,18,0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBlock Text="병사 목록" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="군번 · 이름 · 소속 검색" Style="{StaticResource MutedText}"/>
                                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="병사 검색"/>
                                    </StackPanel>
                                    <DataGrid ItemsSource="{Binding Soldiers}" SelectedItem="{Binding SelectedSoldier}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="군번" Binding="{Binding Id}" Width="130"/>
                                            <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="계급" Binding="{Binding Rank}" Width="80"/>
                                            <DataGridTextColumn Header="소속" Binding="{Binding Unit}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Panel}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="병사 정보" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="군번 (고유 ID)"/>
                                        <TextBox Text="{Binding SoldierId, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="군번"/>
                                        <TextBlock Text="이름"/>
                                        <TextBox Text="{Binding SoldierName, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="이름"/>
                                        <TextBlock Text="계급"/>
                                        <TextBox Text="{Binding Rank, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="계급"/>
                                        <TextBlock Text="소속"/>
                                        <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="소속"/>
                                        <Button Content="신규 등록" Command="{Binding AddSoldierCommand}"
                                                Style="{StaticResource Primary}" Margin="0,6,0,8"/>
                                        <Button Content="선택 병사 수정" Command="{Binding UpdateSoldierCommand}" Margin="0,0,0,8"/>
                                        <Button Content="입력 초기화" Command="{Binding NewSoldierCommand}"/>
                                        <TextBlock Text="목록에서 병사를 선택하면 수정할 수 있습니다. 수정 시 군번은 유지하세요."
                                                   TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,20,0,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ===== 재고 관리 ===== -->
                    <TabItem Header="재고 관리">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Panel}" Margin="0,0,18,0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBlock Text="군수품 재고 관리" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="품목코드 · 품목명 · 구분 검색" Style="{StaticResource MutedText}"/>
                                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="재고 검색"/>
                                    </StackPanel>
                                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="코드" Binding="{Binding Id}" Width="90"/>
                                            <DataGridTextColumn Header="품목명" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="구분" Binding="{Binding Category}" Width="90"/>
                                            <DataGridTextColumn Header="가용" Binding="{Binding Quantity}" Width="58"/>
                                            <DataGridTextColumn Header="기준" Binding="{Binding Minimum}" Width="58"/>
                                            <DataGridTextColumn Header="지급" Binding="{Binding Requirement}" Width="58"/>
                                            <DataGridTemplateColumn Header="상태" CellTemplate="{StaticResource StatusCell}" Width="76"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Panel}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="품목 정보 / 재고 조정" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="품목코드 (고유 ID)"/>
                                        <TextBox Text="{Binding ItemId, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="품목코드"/>
                                        <TextBlock Text="품목명"/>
                                        <TextBox Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="품목명"/>
                                        <TextBlock Text="구분"/>
                                        <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="구분"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="가용재고"/>
                                                <TextBox Text="{Binding StockQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="가용재고"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="최소재고"/>
                                                <TextBox Text="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="최소재고"/>
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox Content="개인 필수장비 (지급률 계산 대상)" IsChecked="{Binding Required}"/>
                                        <Button Content="품목 신규 등록" Command="{Binding AddItemCommand}"
                                                Style="{StaticResource Primary}" Margin="0,0,0,8"/>
                                        <Button Content="선택 품목 수정 / 재고 조정" Command="{Binding UpdateItemCommand}" Margin="0,0,0,8"/>
                                        <Button Content="입력 초기화" Command="{Binding NewItemCommand}"/>
                                        <TextBlock Text="가용재고는 창고에 남아 있는 수량입니다. 지급 중인 수량은 통계에서 확인하세요."
                                                   TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,20,0,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ===== 장비 지급 ===== -->
                    <TabItem Header="장비 지급">
                        <views:EquipmentIssueView/>
                    </TabItem>

                    <!-- ===== 보급 요청 ===== -->
                    <TabItem Header="보급 요청">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource Panel}" Margin="0,0,0,18">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="보급 요청 등록" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="요청  →  승인  →  입고 완료" Foreground="{StaticResource AccentText}"
                                                   HorizontalAlignment="Right" Margin="0,0,0,16"/>
                                    </DockPanel>

                                    <Border Background="{StaticResource WarningSurface}" BorderBrush="{StaticResource Line}"
                                            BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
                                        <DockPanel>
                                            <CheckBox Content="부족 품목만 보기" IsChecked="{Binding ShowShortageOnly}"
                                                      FontWeight="Medium" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding RequestStockSummary}" Foreground="{StaticResource Warning}"
                                                       FontWeight="Medium" FontSize="12"/>
                                        </DockPanel>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="320"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Margin="0,0,14,0">
                                            <TextBlock Text="보급 품목 · 부족량 순"/>
                                            <ComboBox ItemsSource="{Binding RequestItems}" SelectedItem="{Binding RequestItem}"
                                                      AutomationProperties.Name="보급 품목">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                        <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RequestItem.IsShortage}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,2">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                        <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsShortage}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding SupplySummary}" FontSize="11"
                                                                       Margin="0,5,0,0" Foreground="{StaticResource Muted}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Text="부족 품목이 없습니다. 체크를 해제하면 전체 품목을 볼 수 있습니다."
                                                       Foreground="{StaticResource Success}" FontSize="11"
                                                       TextWrapping="Wrap" Margin="0,0,0,8">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RequestItems.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                            <TextBlock Text="요청 수량"/>
                                            <TextBox Text="{Binding RequestQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="요청 수량"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="0,0,14,0">
                                            <TextBlock Text="요청 사유"/>
                                            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="요청 사유"/>
                                        </StackPanel>

                                        <Button Grid.Column="3" Content="요청 등록" Command="{Binding RequestCommand}"
                                                Style="{StaticResource Primary}" VerticalAlignment="Top" Margin="0,23,0,0"/>
                                    </Grid>

                                    <TextBlock Text="{Binding RequestItemSummary}" Margin="0,0,0,10" FontWeight="Medium">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RequestItem.IsShortage}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="부족량 = 최소재고 − 현재 가용재고. 선택 시 부족량을 기본 입력하며 요청 수량은 수정할 수 있습니다."
                                               Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource Panel}">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                                        <TextBlock Text="보급 요청 목록" FontSize="17" FontWeight="Bold"/>
                                        <Button Content="선택 요청 승인 / 입고 완료" Command="{Binding AdvanceCommand}"
                                                HorizontalAlignment="Right"/>
                                    </Grid>
                                    <DataGrid ItemsSource="{Binding Requests}" SelectedItem="{Binding SelectedRequest}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="요청일" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="115"/>
                                            <DataGridTextColumn Header="품목" Binding="{Binding Item}" Width="140"/>
                                            <DataGridTextColumn Header="수량" Binding="{Binding Quantity}" Width="65"/>
                                            <DataGridTextColumn Header="요청 사유" Binding="{Binding Reason}" Width="*"/>
                                            <DataGridTemplateColumn Header="상태" CellTemplate="{StaticResource StatusCell}" Width="110"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ===== 통계 ===== -->
                    <TabItem Header="통계">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <UniformGrid Columns="3" Margin="0,0,-14,18">
                                    <Border Style="{StaticResource Panel}" Margin="0,0,14,0">
                                        <StackPanel>
                                            <TextBlock Text="총 가용재고" Foreground="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding TotalAvailable, StringFormat={}{0:N0}개}" FontSize="30"
                                                       FontWeight="Bold" Foreground="{StaticResource AccentText}" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Panel}" Margin="0,0,14,0">
                                        <StackPanel>
                                            <TextBlock Text="지급 중 장비" Foreground="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding TotalIssued, StringFormat={}{0:N0}개}" FontSize="30"
                                                       FontWeight="Bold" Foreground="{StaticResource AccentText}" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Panel}" Margin="0,0,14,0">
                                        <StackPanel>
                                            <TextBlock Text="병사 1인당 필수 품목" Foreground="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding RequiredCount, StringFormat={}{0}종}" FontSize="30"
                                                       FontWeight="Bold" Foreground="{StaticResource AccentText}" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Style="{StaticResource Panel}" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="품목별 보유 현황" Style="{StaticResource SectionTitle}"/>
                                        <DataGrid ItemsSource="{Binding Stats}" Height="240">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="품목" Binding="{Binding Item}" Width="*"/>
                                                <DataGridTextColumn Header="구분" Binding="{Binding Category}" Width="160"/>
                                                <DataGridTextColumn Header="가용재고" Binding="{Binding Available}" Width="110"/>
                                                <DataGridTextColumn Header="지급 중" Binding="{Binding Issued}" Width="110"/>
                                                <DataGridTextColumn Header="확정 대기" Binding="{Binding Reserved}" Width="100"/>
                                                <DataGridTextColumn Header="최소재고" Binding="{Binding Minimum}" Width="100"/>
                                                <DataGridTemplateColumn Header="상태" CellTemplate="{StaticResource StatusCell}" Width="85"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <TextBlock Text="변경 이력" Style="{StaticResource SectionTitle}"/>
                                        <DataGrid ItemsSource="{Binding History}" Height="220">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="처리일시" Binding="{Binding Date, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="180"/>
                                                <DataGridTextColumn Header="작업" Binding="{Binding Action}" Width="150"/>
                                                <DataGridTextColumn Header="상세" Binding="{Binding Detail}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="{Binding StoragePath}" Foreground="{StaticResource Muted}"
                                                   FontSize="10" Margin="0,14,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- ===== 하단 상태 표시줄 ===== -->
        <Border Grid.Row="2" Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="20,0">
            <DockPanel>
                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource Text}"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>